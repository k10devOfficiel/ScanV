# ==============================================================================
# ScanV - Fichier de configuration d'environnement (.env.example)
# Copiez ce fichier vers .env et adaptez les valeurs selon votre environnement.
# ==============================================================================

APP_NAME=ScanV
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# Clé secrète de l'application (64 caractères hexadécimaux pour HMAC-SHA256)
# Générer avec : php -r "echo bin2hex(random_bytes(32));"
APP_KEY=change_this_to_a_secure_64_character_hex_key_for_production_env_use

# ==============================================================================
# Base de données MySQL
# ==============================================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=scanv
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# ==============================================================================
# Sessions
# ==============================================================================
SESSION_LIFETIME=7200
SESSION_SECURE_COOKIE=false

# ==============================================================================
# Configuration E-mail (MailService)
# Drivers disponibles :
#   - log  : Écrit les e-mails dans storage/logs/mail.log (valable UNIQUEMENT si APP_ENV=local).
#            Refuse strictement de démarrer si APP_ENV=production.
#   - smtp : Envoi via serveur SMTP (Mailpit en local, ou votre fournisseur en production).
# ==============================================================================
MAIL_DRIVER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=noreply@scanv.test
MAIL_FROM_NAME="ScanV"

# Paramètres de sécurité du système OTP
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60

# ==============================================================================
# EXEMPLES DE CONFIGURATION COURANTS :
#
# --- Cas 1 : WampServer en local avec journalisation (aucun serveur mail requis) ---
# APP_ENV=local
# MAIL_DRIVER=log
# Les codes et e-mails sont lisibles dans : storage/logs/mail.log
#
# --- Cas 2 : WampServer en local avec Mailpit (interface web sur http://localhost:8025) ---
# APP_ENV=local
# MAIL_DRIVER=smtp
# MAIL_HOST=127.0.0.1
# MAIL_PORT=1025
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=
# MAIL_FROM_ADDRESS=noreply@scanv.test
# MAIL_FROM_NAME="ScanV"
#
# --- Cas 3 : Serveur de Production (SMTP réel TLS/SSL) ---
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://cartes.votredomaine.com
# APP_KEY=cle_aleatoire_64_hex_imperative_en_production
# SESSION_SECURE_COOKIE=true
# MAIL_DRIVER=smtp
# MAIL_HOST=smtp.votrefournisseur.com
# MAIL_PORT=587
# MAIL_USERNAME=contact@votredomaine.com
# MAIL_PASSWORD=votre_mot_de_passe_smtp_secret
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=noreply@votredomaine.com
# MAIL_FROM_NAME="ScanV Support"
# ==============================================================================
